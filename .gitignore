# ---------- macOS ----------
.DS_Store

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
.venv/
venv/
env/
.python-version

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Outputs (per CLIF-org convention) ----------
output/intermediate/*
output/final/*
!output/intermediate/.gitkeep
!output/final/.gitkeep
!output/README.md

# clifpy validate_all() writes DQA artifacts to the cwd; ignore those
validation_errors_*.csv
missing_data_stats_*.csv
summary_statistics_*.csv
skewness_analysis_*.csv

# Notebook-cwd-relative output dirs auto-created by clifpy
code/output/
dev/output/
docs/

# ---------- Rendered reports ----------
*.pdf
!slides/*.pdf
*.html
*.log
logs/

# ---------- Local site config (must never leave the user's machine) ----------
config/config.json
